FROM mitmproxy/mitmproxy:latest

# Install uv for ultra-fast dependency resolution (10x faster than pip)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy ONLY pyproject.toml first to cache dependency installation
COPY pyproject.toml /app/

# Create stub src/ directory so pip/uv can parse project metadata without source
RUN mkdir -p /app/src/inspect_docker_auditor && \
    touch /app/src/inspect_docker_auditor/__init__.py

# Install dependencies (Cached unless pyproject.toml changes!)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -e .

# Copy actual source code LAST
COPY src/ /app/src/

# Fast non-interactive re-install of local package code only
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --no-deps -e .

ENV PYTHONPATH="/app/src"
